<Page
    x:Class="TrelloNotifier.BulkCreateCardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{ThemeResource AppTextPrimaryBrush}"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="18" Margin="0,0,12,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactImport">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FilePanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DestinationPanel.(Grid.Row)" Value="2" />
                        <Setter Target="DestinationPanel.(Grid.Column)" Value="0" />
                        <Setter Target="DestinationPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ImportActions.(Grid.Row)" Value="1" />
                        <Setter Target="ImportActions.(Grid.Column)" Value="0" />
                        <Setter Target="ImportActions.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ImportActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="ImportActions.Margin" Value="0,12,0,0" />
                        <Setter Target="StepConnectorOne.Width" Value="12" />
                        <Setter Target="StepConnectorTwo.Width" Value="12" />
                        <Setter Target="TableHeadings.Visibility" Value="Collapsed" />
                        <Setter Target="ResultSummaryGrid.ColumnSpacing" Value="8" />
                        <Setter Target="CreatedSummaryIcon.Visibility" Value="Collapsed" />
                        <Setter Target="PendingSummaryIcon.Visibility" Value="Collapsed" />
                        <Setter Target="ExcludedSummaryIcon.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideImport">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="FileStep" />
                <VisualState x:Name="ReviewStep">
                    <VisualState.Setters>
                        <Setter Target="StepTwo.Background" Value="{ThemeResource AppBrandBrush}" />
                        <Setter Target="StepTwoNumber.Foreground" Value="{ThemeResource AppBrandTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ResultStep">
                    <VisualState.Setters>
                        <Setter Target="StepTwo.Background" Value="{ThemeResource AppBrandBrush}" />
                        <Setter Target="StepTwoNumber.Foreground" Value="{ThemeResource AppBrandTextBrush}" />
                        <Setter Target="StepThree.Background" Value="{ThemeResource AppBrandBrush}" />
                        <Setter Target="StepThreeNumber.Foreground" Value="{ThemeResource AppBrandTextBrush}" />
                        <Setter Target="NumberHeadingColumn.Width" Value="0" />
                        <Setter Target="NumberHeading.Visibility" Value="Collapsed" />
                        <Setter Target="DueHeadingColumn.Width" Value="0" />
                        <Setter Target="DueHeading.Visibility" Value="Collapsed" />
                        <Setter Target="ActionHeadingColumn.Width" Value="150" />
                        <Setter Target="ActionHeading.Visibility" Value="Visible" />
                        <Setter Target="TitleHeading.Text" Value="TARJETA" />
                        <Setter Target="StatusHeading.Text" Value="RESULTADO" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
            <TextBlock Text="Crear tarjetas en lote" Style="{StaticResource PageTitleStyle}" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryActionButtonStyle}" CornerRadius="12" Padding="12,9"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="DownloadTemplate_Click"
                    IsEnabled="{Binding IsEnabled, ElementName=SetupPanel}" Visibility="{Binding Visibility, ElementName=SetupPanel}"
                    AutomationProperties.Name="Descargar plantilla CSV">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                    <TextBlock Text="Descargar plantilla" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="PageDescription" Grid.Row="1" Grid.ColumnSpan="2" Text="Importa un CSV y elige dónde se crearán tus tarjetas."
                       Style="{StaticResource SecondaryTextStyle}" FontSize="16" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="20,16">
            <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{ThemeResource AppBrandBrush}">
                        <TextBlock Text="1" Foreground="{ThemeResource AppBrandTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Archivo y destino" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <Border x:Name="StepConnectorOne" Grid.Column="1" Width="64" Height="1" Background="{ThemeResource AppPanelBorderBrush}" />
                <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border x:Name="StepTwo" Width="30" Height="30" CornerRadius="15" Background="{ThemeResource AppControlBackgroundBrush}">
                        <TextBlock x:Name="StepTwoNumber" Text="2" Foreground="{ThemeResource AppTextSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Revisar tarjetas" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <Border x:Name="StepConnectorTwo" Grid.Column="3" Width="64" Height="1" Background="{ThemeResource AppPanelBorderBrush}" />
                <Grid Grid.Column="4" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border x:Name="StepThree" Width="30" Height="30" CornerRadius="15" Background="{ThemeResource AppControlBackgroundBrush}">
                        <TextBlock x:Name="StepThreeNumber" Text="3" Foreground="{ThemeResource AppTextSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Resultado" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Name="ImportInfoBar" IsOpen="False" IsClosable="True" CornerRadius="8" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionTextStyle}" Visibility="Collapsed" />
            <ProgressBar x:Name="ImportProgress" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="3">
            <UserControl x:Name="SetupPanel" IsTabStop="False">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="1.5*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="18" Padding="0,0,0,4">
                        <Border x:Name="CsvFieldsPanel" Grid.ColumnSpan="2"
                                Background="{ThemeResource AppAccentSurfaceBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Cómo preparar el CSV" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentTextBrush}" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="Primera fila: nombres de columna sin tildes ni asteriscos. Después, una tarjeta por fila." />
                                <Grid Margin="16,0,0,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                                    <TextBlock Text="○" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextStyle}">
                                        <Run Text="titulo" FontWeight="Bold" />
                                        <Run Text="*" Foreground="{ThemeResource AppDangerTextBrush}" FontWeight="Bold" />
                                        <Run Text=": Nombre de la tarjeta." />
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Text="○" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptionTextStyle}">
                                        <Run Text="descripcion" FontWeight="Bold" />
                                        <Run Text=": Detalles de la tarjeta. Admite Markdown." />
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Text="○" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource CaptionTextStyle}">
                                        <Run Text="vencimiento" FontWeight="Bold" />
                                        <Run Text=": Fecha y hora con zona horaria. Ejemplo: 2026-12-05T09:00:00-05:00." />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Text="○" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource CaptionTextStyle}">
                                        <Run Text="responsables" FontWeight="Bold" />
                                        <Run Text=": Usuarios del tablero separados por punto y coma. Ejemplo: ana;juan." />
                                    </TextBlock>
                                </Grid>
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="Usa comillas dobles si un valor contiene el separador del CSV o saltos de línea." />
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Text="Formato: CSV UTF-8 · Máximo 1000 tarjetas y 2 MiB." />
                            </StackPanel>
                        </Border>
                        <Border x:Name="FilePanel" Grid.Row="1" Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="1. Selecciona tu archivo" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Una fila por tarjeta. Puedes preparar el archivo en Excel." Style="{StaticResource SecondaryTextStyle}" />
                                <Grid AllowDrop="True" DragOver="Csv_DragOver" Drop="Csv_Drop" MinHeight="198">
                                    <Rectangle Fill="{ThemeResource AppAccentSurfaceBrush}" Opacity="0.35" RadiusX="10" RadiusY="10" />
                                    <Rectangle Stroke="{ThemeResource AppAccentTextBrush}" StrokeDashArray="6,4" StrokeThickness="1" Opacity="0.5" RadiusX="10" RadiusY="10" />
                                    <StackPanel Spacing="8" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="46" Height="48" CornerRadius="7" Background="{ThemeResource AppAccentSurfaceBrush}" BorderBrush="{ThemeResource AppPanelBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="CSV" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Arrastra tu archivo CSV aquí" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Text="o selecciónalo desde tu equipo" Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" />
                                        <Button Content="Elegir archivo" HorizontalAlignment="Center" Click="ChooseFile_Click" Style="{StaticResource ActionButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="SelectedFilePanel" CornerRadius="8" Padding="14" Background="{ThemeResource AppPageBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppPanelBorderBrush}" BorderThickness="1" Visibility="Collapsed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource AccentBadgeStyle}" VerticalAlignment="Center"><TextBlock Text="CSV" Foreground="{ThemeResource AppAccentTextBrush}" FontSize="12" /></Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock x:Name="SelectedFileName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="FileSummary" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="2" Content="Cambiar" Click="ChooseFile_Click" VerticalAlignment="Center" Padding="0" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="CSV UTF-8 · Hasta 1000 tarjetas / 2 MiB" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="DestinationPanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="20">
                                <TextBlock Text="2. Destino del lote" Style="{StaticResource SectionTitleStyle}" />
                                <ComboBox x:Name="BoardComboBox" Header="Tablero" DisplayMemberPath="Name" PlaceholderText="Selecciona un tablero"
                                          Style="{StaticResource InputComboBoxStyle}" SelectionChanged="Board_SelectionChanged" />
                                <ComboBox x:Name="ListComboBox" Header="Lista" DisplayMemberPath="Name" PlaceholderText="Selecciona una lista"
                                          Style="{StaticResource InputComboBoxStyle}" SelectionChanged="Destination_Changed" />
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Responsables predeterminados" TextWrapping="Wrap" />
                                    <Button x:Name="MembersButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource ActionButtonStyle}" AutomationProperties.Name="Seleccionar responsables predeterminados">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock x:Name="SelectedMembersText" Text="Sin asignar" TextTrimming="CharacterEllipsis" />
                                            <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="10" />
                                        </Grid>
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Spacing="10" Width="320">
                                                    <TextBlock Text="Selecciona uno o varios miembros" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <ListView x:Name="MembersList" MaxHeight="220" SelectionMode="Multiple" DisplayMemberPath="DisplayName"
                                                              SelectionChanged="Members_SelectionChanged" AutomationProperties.Name="Responsables del lote" />
                                                    <TextBlock Text="También puedes indicar usuarios por fila en la columna responsables, separados por punto y coma." Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <Border Background="{ThemeResource AppAccentSurfaceBrush}" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Avisos de vencimiento" Foreground="{ThemeResource AppAccentTextBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="Las tarjetas asignadas a ti aparecerán en Mis tarjetas. Añade una fecha para recibir los recordatorios configurados."
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <HyperlinkButton x:Name="ReloadButton" Content="Volver a cargar tableros" Click="Reload_Click" Padding="0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </UserControl>

            <Grid x:Name="ReviewPanel" Visibility="Collapsed" RowDefinitions="Auto,*,Auto" RowSpacing="14">
                <StackPanel Spacing="14">
                <Border x:Name="SourceSummaryPanel" Style="{StaticResource PanelStyle}" Padding="20,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="ReviewFileName" FontWeight="SemiBold" />
                            <TextBlock x:Name="DestinationText" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="Cambiar" Click="EditSource_Click" Padding="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel x:Name="ValidationBadges" Orientation="Horizontal" Spacing="12">
                    <Border Style="{StaticResource AccentBadgeStyle}"><TextBlock x:Name="ReadCountText" Foreground="{ThemeResource AppAccentTextBrush}" FontSize="12" FontWeight="SemiBold" /></Border>
                    <Border Style="{StaticResource AccentBadgeStyle}" Background="{ThemeResource AppSuccessSurfaceBrush}"><TextBlock x:Name="ValidCountText" Foreground="{ThemeResource AppSuccessTextBrush}" FontSize="12" FontWeight="SemiBold" /></Border>
                    <Border Style="{StaticResource AccentBadgeStyle}" Background="{ThemeResource AppDangerSurfaceBrush}"><TextBlock x:Name="InvalidCountText" Foreground="{ThemeResource AppDangerTextBrush}" FontSize="12" FontWeight="SemiBold" /></Border>
                </StackPanel>
                <Grid x:Name="ResultSummaryGrid" ColumnDefinitions="*,*,*" ColumnSpacing="14" Visibility="Collapsed">
                    <Border Style="{StaticResource PanelStyle}" Padding="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border x:Name="CreatedSummaryIcon" Style="{StaticResource SummaryIconStyle}" Background="{ThemeResource AppSuccessSurfaceBrush}"><FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="{ThemeResource AppSuccessTextBrush}" /></Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="CreatedCountText" Style="{StaticResource SummaryNumberStyle}" Foreground="{ThemeResource AppSuccessTextBrush}" />
                                <TextBlock Text="Tarjetas creadas" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border x:Name="PendingSummaryIcon" Style="{StaticResource SummaryIconStyle}" Background="{ThemeResource AppDangerSurfaceBrush}"><FontIcon Glyph="&#xE7BA;" FontSize="24" Foreground="{ThemeResource AppDangerTextBrush}" /></Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="PendingCountText" Style="{StaticResource SummaryNumberStyle}" Foreground="{ThemeResource AppDangerTextBrush}" />
                                <TextBlock x:Name="PendingCountLabel" Text="Pendientes de reintento" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="18">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border x:Name="ExcludedSummaryIcon" Style="{StaticResource SummaryIconStyle}" Background="{ThemeResource AppAccentSurfaceBrush}"><FontIcon Glyph="&#xE738;" FontSize="24" Foreground="{ThemeResource AppAccentTextBrush}" /></Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="ExcludedCountText" Style="{StaticResource SummaryNumberStyle}" Foreground="{ThemeResource AppAccentTextBrush}" />
                                <TextBlock Text="Filas excluidas" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <InfoBar x:Name="ValidationInfoBar" Severity="Warning" IsOpen="False" IsClosable="False" CornerRadius="8"
                         Message="Puedes corregir el CSV y volver a cargarlo, o excluir las filas con errores para continuar." />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <TextBlock x:Name="ResultTableTitle" Text="Detalle del lote" Style="{StaticResource SectionTitleStyle}" Margin="20,16" Visibility="Collapsed" />
                        <Border x:Name="TableHeadings" Grid.Row="1" Background="{ThemeResource AppControlBackgroundBrush}" Padding="20,10" BorderBrush="{ThemeResource AppPanelBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="NumberHeadingColumn" Width="40" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition x:Name="DueHeadingColumn" Width="1.2*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition x:Name="ActionHeadingColumn" Width="0" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NumberHeading" Text="No" Style="{StaticResource TableHeadingStyle}" />
                                <TextBlock x:Name="TitleHeading" Grid.Column="1" Text="TÍTULO / DESCRIPCIÓN" Style="{StaticResource TableHeadingStyle}" />
                                <TextBlock x:Name="DueHeading" Grid.Column="2" Text="VENCIMIENTO" Style="{StaticResource TableHeadingStyle}" />
                                <TextBlock x:Name="StatusHeading" Grid.Column="3" Text="VALIDACIÓN" Style="{StaticResource TableHeadingStyle}" />
                                <TextBlock x:Name="ActionHeading" Grid.Column="4" Text="ACCIÓN" Style="{StaticResource TableHeadingStyle}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ListView x:Name="RowsList" Grid.Row="2" SelectionMode="None" ItemContainerStyle="{StaticResource CardListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <UserControl Loaded="ImportRow_Loaded" DataContextChanged="ImportRow_DataContextChanged" HorizontalContentAlignment="Stretch" IsTabStop="False">
                                        <Grid>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup>
                                                    <VisualState x:Name="Ready" />
                                                    <VisualState x:Name="Created" />
                                                    <VisualState x:Name="Invalid">
                                                        <VisualState.Setters>
                                                            <Setter Target="RowTint.Visibility" Value="Visible" />
                                                            <Setter Target="StatusBadge.Background" Value="{ThemeResource AppDangerSurfaceBrush}" />
                                                            <Setter Target="StatusContent.Foreground" Value="{ThemeResource AppDangerTextBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Rejected">
                                                        <VisualState.Setters>
                                                            <Setter Target="RowTint.Visibility" Value="Visible" />
                                                            <Setter Target="StatusBadge.Background" Value="{ThemeResource AppDangerSurfaceBrush}" />
                                                            <Setter Target="StatusContent.Foreground" Value="{ThemeResource AppDangerTextBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Uncertain">
                                                        <VisualState.Setters>
                                                            <Setter Target="StatusBadge.Background" Value="{ThemeResource AppWarningSurfaceBrush}" />
                                                            <Setter Target="StatusContent.Foreground" Value="{ThemeResource AppWarningTextBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Excluded">
                                                        <VisualState.Setters>
                                                            <Setter Target="StatusBadge.Background" Value="{ThemeResource AppAccentSurfaceBrush}" />
                                                            <Setter Target="StatusContent.Foreground" Value="{ThemeResource AppAccentTextBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Creating">
                                                        <VisualState.Setters>
                                                            <Setter Target="StatusBadge.Background" Value="{ThemeResource AppAccentSurfaceBrush}" />
                                                            <Setter Target="StatusContent.Foreground" Value="{ThemeResource AppAccentTextBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                                <VisualStateGroup>
                                                    <VisualState x:Name="PreviewRow" />
                                                    <VisualState x:Name="ResultRow">
                                                        <VisualState.Setters>
                                                            <Setter Target="NumberColumn.Width" Value="0" />
                                                            <Setter Target="RowNumberText.Visibility" Value="Collapsed" />
                                                            <Setter Target="DueColumn.Width" Value="0" />
                                                            <Setter Target="DueText.Visibility" Value="Collapsed" />
                                                            <Setter Target="RowDescription.Visibility" Value="Collapsed" />
                                                            <Setter Target="RowMembers.Visibility" Value="Collapsed" />
                                                            <Setter Target="ActionColumn.Width" Value="150" />
                                                            <Setter Target="OpenResultButton.Visibility" Value="Visible" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                                <VisualStateGroup>
                                                    <VisualState x:Name="CompactRow">
                                                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                                        <VisualState.Setters>
                                                            <Setter Target="RowNumberText.Visibility" Value="Collapsed" />
                                                            <Setter Target="TitleCell.(Grid.Column)" Value="0" />
                                                            <Setter Target="TitleCell.(Grid.ColumnSpan)" Value="5" />
                                                            <Setter Target="TitleCell.Margin" Value="0,0,0,10" />
                                                            <Setter Target="DueText.(Grid.Row)" Value="1" />
                                                            <Setter Target="DueText.(Grid.Column)" Value="0" />
                                                            <Setter Target="DueText.(Grid.ColumnSpan)" Value="3" />
                                                            <Setter Target="StatusBadge.(Grid.Row)" Value="2" />
                                                            <Setter Target="StatusBadge.(Grid.Column)" Value="0" />
                                                            <Setter Target="StatusBadge.(Grid.ColumnSpan)" Value="3" />
                                                            <Setter Target="StatusBadge.Margin" Value="0,8,0,0" />
                                                            <Setter Target="OpenResultButton.(Grid.Row)" Value="1" />
                                                            <Setter Target="OpenResultButton.(Grid.RowSpan)" Value="2" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="WideRow">
                                                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Border x:Name="RowTint" Background="{ThemeResource AppDangerSurfaceBrush}" Opacity="0.3" Visibility="Collapsed" />
                                            <Border Padding="20,14" BorderBrush="{ThemeResource AppPanelBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="NumberColumn" Width="40" />
                                                        <ColumnDefinition Width="2.2*" />
                                                        <ColumnDefinition x:Name="DueColumn" Width="1.2*" />
                                                        <ColumnDefinition Width="1.6*" />
                                                        <ColumnDefinition x:Name="ActionColumn" Width="0" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="RowNumberText" Text="{Binding RowNumber}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                                    <StackPanel x:Name="TitleCell" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="RowDescription" Text="{Binding Draft.Description}" MaxLines="2" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextStyle}" />
                                                        <TextBlock x:Name="RowMembers" Text="{Binding MemberSummary}" Style="{StaticResource CaptionTextStyle}" />
                                                        <TextBlock x:Name="RowMessage" Text="{Binding Message}" Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="DueText" Grid.Column="2" Text="{Binding DueText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                                    <Border x:Name="StatusBadge" Grid.Column="3" Style="{StaticResource AccentBadgeStyle}" Background="{ThemeResource AppSuccessSurfaceBrush}" VerticalAlignment="Center">
                                                        <UserControl x:Name="StatusContent" Foreground="{ThemeResource AppSuccessTextBrush}" IsTabStop="False">
                                                            <TextBlock x:Name="BadgeText" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </UserControl>
                                                    </Border>
                                                    <HyperlinkButton x:Name="OpenResultButton" Grid.Column="4" Content="Ver en Trello ↗" Tag="{Binding}" IsEnabled="{Binding CanOpen}"
                                                                     Click="OpenCard_Click" Padding="0" Visibility="Collapsed" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </UserControl>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <Button x:Name="CorrectFileButton" Grid.Row="2" Content="Corregir CSV y volver a cargar" Click="CorrectFile_Click"
                        Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
            <StackPanel Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionTextStyle}" Visibility="Collapsed" />
                <CheckBox x:Name="ExcludeInvalidCheckBox" Content="Excluir las filas con errores" Visibility="Collapsed"
                          Checked="ExcludeInvalid_Changed" Unchecked="ExcludeInvalid_Changed" />
                <HyperlinkButton x:Name="ExportButton" Content="↓  Descargar resultados" Click="Export_Click" Visibility="Collapsed" Padding="0" />
                <TextBlock x:Name="FooterHint" Text="Siguiente: revisar los datos antes de crear." Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel x:Name="ImportActions" Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BackButton" Content="Cancelar" Click="Back_Click" Style="{StaticResource ActionButtonStyle}" />
                <Button x:Name="EditSourceButton" Content="← Atrás" Click="EditSource_Click" Visibility="Collapsed" Style="{StaticResource ActionButtonStyle}" />
                <Button x:Name="NewImportButton" Content="Nueva importación" Click="NewImport_Click" Visibility="Collapsed" Style="{StaticResource ActionButtonStyle}" />
                <Button x:Name="ReviewButton" Content="Revisar tarjetas →" Click="Review_Click" Style="{StaticResource PrimaryActionButtonStyle}" IsEnabled="False" />
                <Button x:Name="CreateButton" Content="Crear tarjetas en Trello" Click="Create_Click" Visibility="Collapsed" Style="{StaticResource PrimaryActionButtonStyle}" />
                <Button x:Name="StopButton" Content="Detener después de esta tarjeta" Click="Stop_Click" Visibility="Collapsed" Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
