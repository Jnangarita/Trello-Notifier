<Page
    x:Class="TrelloNotifier.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{ThemeResource AppTextPrimaryBrush}"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <LinearGradientBrush x:Key="WeatherBackgroundBrush" StartPoint="0,1" EndPoint="1,0">
                        <GradientStop Color="#1760B4" Offset="0" />
                        <GradientStop Color="#102C59" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="WeatherBorderBrush" Color="#4478B7" />
                    <SolidColorBrush x:Key="WeatherTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WeatherSecondaryBrush" Color="#D4E6FF" />
                    <SolidColorBrush x:Key="WeatherMutedBrush" Color="#A9CCF6" />
                    <SolidColorBrush x:Key="WeatherBadgeBrush" Color="#079EFA" />
                    <SolidColorBrush x:Key="WeatherBadgeForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WeatherSunBrush" Color="#FFD43B" />
                    <LinearGradientBrush x:Key="WeatherCloudBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#ACD8FF" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WeatherBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WeatherBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WeatherTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WeatherSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WeatherMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WeatherBadgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WeatherBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="WeatherSunBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WeatherCloudBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer x:Name="DashboardScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" HorizontalAlignment="Left" Width="340"
                    MaxWidth="{Binding ActualWidth, ElementName=DashboardScroll}">
            <StackPanel Spacing="4">
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Bienvenido a Trello Notifier." Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Border x:Name="WeatherCard" Style="{StaticResource PanelStyle}" Padding="16,12,12,16"
                    Background="{ThemeResource WeatherBackgroundBrush}" BorderBrush="{ThemeResource WeatherBorderBrush}"
                    CornerRadius="14">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{ThemeResource WeatherBadgeBrush}">
                            <FontIcon Glyph="&#xE753;" FontSize="17" Foreground="{ThemeResource WeatherBadgeForegroundBrush}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Clima" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center" Foreground="{ThemeResource WeatherTextBrush}" />
                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Path Width="9" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{ThemeResource WeatherMutedBrush}"
                                  Data="F0 M 6,0 C 2.7,0 0,2.7 0,6 C 0,10 6,16 6,16 C 6,16 12,10 12,6 C 12,2.7 9.3,0 6,0 Z M 6,3 A 3,3 0 1 0 6,9 A 3,3 0 1 0 6,3 Z" />
                            <TextBlock x:Name="LocationText" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource WeatherSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Button x:Name="RefreshWeatherButton" Grid.Column="3" Style="{StaticResource PaginationButtonStyle}"
                                Foreground="{ThemeResource WeatherSecondaryBrush}" Click="RefreshWeather_Click"
                                AutomationProperties.Name="Actualizar clima" ToolTipService.ToolTip="Consultar el clima ahora, sin usar la caché">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="100,*" ColumnSpacing="10">
                        <Viewbox MaxWidth="100" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                            <Canvas Width="100" Height="90">
                                <Canvas x:Name="SunIllustration" Visibility="Collapsed">
                                    <Path Data="M 34,3 L 34,10 M 34,58 L 34,65 M 3,34 L 10,34 M 58,34 L 65,34 M 12,12 L 17,17 M 51,51 L 56,56 M 12,56 L 17,51 M 51,17 L 56,12"
                                          Stroke="{ThemeResource WeatherSunBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse Canvas.Left="15" Canvas.Top="15" Width="38" Height="38" Fill="{ThemeResource WeatherSunBrush}" />
                                </Canvas>
                                <Path x:Name="MoonIllustration" Visibility="Collapsed" Data="M 42,9 C 12,9 9,54 40,58 C 54,60 62,50 63,43 C 39,49 28,25 42,9 Z"
                                      Fill="{ThemeResource WeatherSunBrush}" />
                                <Path x:Name="CloudIllustration" Visibility="Collapsed"
                                      Data="M 25,72 C 7,72 4,49 20,44 C 17,23 47,18 55,36 C 71,25 88,38 86,51 C 103,55 99,73 85,73 Z"
                                      Fill="{ThemeResource WeatherCloudBrush}" />
                                <Path x:Name="RainIllustration" Visibility="Collapsed" Data="M 29,79 L 25,86 M 49,79 L 45,86 M 69,79 L 65,86"
                                      Stroke="{ThemeResource WeatherMutedBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock x:Name="SnowIllustration" Visibility="Collapsed" Canvas.Left="25" Canvas.Top="66" Text="❄ ❄" FontSize="18"
                                           Foreground="{ThemeResource WeatherTextBrush}" />
                                <Path x:Name="ThunderIllustration" Visibility="Collapsed" Data="M 52,58 L 40,76 L 51,76 L 44,90 L 65,69 L 53,69 L 61,58 Z"
                                      Fill="{ThemeResource WeatherSunBrush}" />
                                <Path x:Name="FogIllustration" Visibility="Collapsed" Data="M 18,77 L 83,77 M 27,85 L 74,85"
                                      Stroke="{ThemeResource WeatherMutedBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <FontIcon x:Name="UnknownIllustration" Glyph="&#xE9CE;" Canvas.Left="24" Canvas.Top="26" FontSize="44"
                                          Foreground="{ThemeResource WeatherMutedBrush}" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="WeatherText" Text="Cargando…" FontSize="34" FontWeight="SemiBold"
                                       Foreground="{ThemeResource WeatherTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="WeatherDetailsText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource WeatherSecondaryBrush}" />
                            <TextBlock x:Name="WeatherConditionText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource WeatherTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
