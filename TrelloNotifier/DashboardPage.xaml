<Page
    x:Class="TrelloNotifier.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="20">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="Mis tarjetas" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Tarjetas abiertas asignadas a tu cuenta de Trello." Opacity="0.7" />
            </StackPanel>
            <Button Grid.Column="1" Content="Comprobar ahora" Click="Refresh_Click" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <FontIcon x:Name="StatusIcon" Glyph="&#xE895;" FontSize="24" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="StatusText" Text="Iniciando monitor..." FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="LastCheckText" Text="Sin comprobaciones todavía" Opacity="0.65" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBox x:Name="CardSearch" PlaceholderText="Buscar tarjeta…"
                     AutomationProperties.Name="Buscar por nombre de tarjeta"
                     TextChanged="CardSearch_TextChanged" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <ComboBox x:Name="StatusFilter" Header="Filtrar por estado" SelectedIndex="0"
                          SelectionChanged="StatusFilter_SelectionChanged" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Todas" Tag="All" />
                    <ComboBoxItem Content="Vencidas" Tag="Overdue" />
                    <ComboBoxItem Content="Próximas a vencer" Tag="DueSoon" />
                    <ComboBoxItem Content="Futuras" Tag="Upcoming" />
                    <ComboBoxItem Content="Sin fecha" Tag="NoDueDate" />
                    <ComboBoxItem Content="Completadas" Tag="Completed" />
                </ComboBox>
                <ComboBox x:Name="BoardFilter" Grid.Column="1" Header="Filtrar por tablero"
                          DisplayMemberPath="Name" SelectedValuePath="Id" HorizontalAlignment="Stretch"
                          SelectionChanged="BoardFilter_SelectionChanged" />
            </Grid>
            <TextBlock x:Name="CardCountText" />
            <TextBlock x:Name="FilterHelpText" Text="Próximas a vencer: según la anticipación configurada para los avisos."
                       Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="3">
            <TextBlock
                x:Name="EmptyMessage"
                Text="Consultando tarjetas..."
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.65" />
            <ListView x:Name="CardsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BoardText}" Opacity="0.65" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding RemainingText}" Foreground="{ThemeResource SystemAccentColor}" />
                                        <TextBlock Text="{Binding DueText}" Opacity="0.65" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Abrir en Trello" Tag="{Binding Url}" Click="OpenCard_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
