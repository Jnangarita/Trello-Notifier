<Page
    x:Class="TrelloNotifier.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{ThemeResource AppTextPrimaryBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16" MaxWidth="1120">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RefreshButton.(Grid.Row)" Value="1" />
                        <Setter Target="RefreshButton.(Grid.Column)" Value="0" />
                        <Setter Target="RefreshButton.Margin" Value="0,12,0,0" />
                        <Setter Target="CardSearch.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="FilterOptions.(Grid.Row)" Value="1" />
                        <Setter Target="FilterOptions.(Grid.Column)" Value="0" />
                        <Setter Target="FilterOptions.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Spacing="6">
                <TextBlock Text="Mis tarjetas" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Tarjetas abiertas asignadas a tu cuenta de Trello." Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Margin="16,0,0,0"
                    Style="{StaticResource PrimaryActionButtonStyle}" Click="Refresh_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    AutomationProperties.Name="Comprobar ahora">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Comprobar ahora" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Style="{StaticResource AccentBadgeStyle}" Width="40" Height="40"
                        Padding="0" CornerRadius="10" VerticalAlignment="Center">
                    <FontIcon x:Name="StatusIcon" Glyph="&#xE895;" FontSize="20"
                              Foreground="{ThemeResource AppAccentTextBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Iniciando monitor..." FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="LastCheckText" Text="Sin comprobaciones todavía" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="16">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="1.2*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                    <TextBox x:Name="CardSearch" Header="Buscar tarjeta" PlaceholderText="Nombre de la tarjeta…"
                             Style="{StaticResource InputTextBoxStyle}"
                             AutomationProperties.Name="Buscar por nombre de tarjeta"
                             TextChanged="CardSearch_TextChanged" />
                    <Grid x:Name="FilterOptions" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <ComboBox x:Name="StatusFilter" Header="Estado" SelectedIndex="0"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  SelectionChanged="StatusFilter_SelectionChanged">
                            <ComboBoxItem Content="Todas" Tag="All" />
                            <ComboBoxItem Content="Vencidas" Tag="Overdue" />
                            <ComboBoxItem Content="Próximas a vencer" Tag="DueSoon" />
                            <ComboBoxItem Content="Futuras" Tag="Upcoming" />
                            <ComboBoxItem Content="Sin fecha" Tag="NoDueDate" />
                            <ComboBoxItem Content="Completadas" Tag="Completed" />
                        </ComboBox>
                        <ComboBox x:Name="BoardFilter" Grid.Column="1" Header="Tablero"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectionChanged="BoardFilter_SelectionChanged" />
                    </Grid>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Style="{StaticResource AccentBadgeStyle}" VerticalAlignment="Top">
                        <TextBlock x:Name="CardCountText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppAccentTextBrush}" />
                    </Border>
                    <TextBlock x:Name="FilterHelpText" Grid.Column="1" VerticalAlignment="Center"
                               Text="Próximas a vencer: según la anticipación configurada para los avisos."
                               Style="{StaticResource CaptionTextStyle}" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock
                x:Name="EmptyMessage"
                Text="Consultando tarjetas..."
                Style="{StaticResource SecondaryTextStyle}"
                TextAlignment="Center" MaxWidth="400" Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <ListView x:Name="CardsList" SelectionMode="None"
                      Background="Transparent" ItemContainerStyle="{StaticResource CardListItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PanelStyle}" Padding="18">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="CompactCard">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="CardDetails.(Grid.ColumnSpan)" Value="2" />
                                                <Setter Target="OpenCardButton.(Grid.Row)" Value="1" />
                                                <Setter Target="OpenCardButton.(Grid.Column)" Value="0" />
                                                <Setter Target="OpenCardButton.Margin" Value="0,12,0,0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideCard">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="800" />
                                            </VisualState.StateTriggers>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <StackPanel x:Name="CardDetails" Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BoardText}" Style="{StaticResource CaptionTextStyle}" />
                                    <Border Style="{StaticResource AccentBadgeStyle}">
                                        <TextBlock Text="{Binding RemainingText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppAccentTextBrush}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding DueText}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <Button x:Name="OpenCardButton" Grid.Column="1" Tag="{Binding Url}"
                                        Style="{StaticResource ActionButtonStyle}" Click="OpenCard_Click"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        AutomationProperties.Name="Abrir en Trello">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Abrir en Trello" />
                                        <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
