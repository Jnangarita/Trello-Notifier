<Page
    x:Class="TrelloNotifier.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer x:Name="SettingsPanel" IsEnabled="False">
        <StackPanel Spacing="22" MaxWidth="620" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Configuración" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Conecta tu cuenta y define cuándo deseas recibir el aviso." Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource PanelStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Conexión" Style="{StaticResource SectionTitleStyle}" />
                    <TextBox x:Name="ApiBaseUrlTextBox" Header="URL base de la API" PlaceholderText="https://api.trello.com" />
                    <TextBox x:Name="ApiKeyTextBox" Header="API key" PlaceholderText="Tu API key de Trello" />
                    <PasswordBox x:Name="TokenPasswordBox" Header="Token" PlaceholderText="Tu token de autorización" />
                    <TextBlock Text="Las credenciales son opcionales cuando utilizas una URL simulada." Opacity="0.65" TextWrapping="Wrap" />
                    <HyperlinkButton Content="Obtener API key y token en Trello" NavigateUri="https://trello.com/app-key" Padding="0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Monitor" Style="{StaticResource SectionTitleStyle}" />
                    <NumberBox x:Name="NotifyBeforeNumberBox" Header="Avisar con esta anticipación (minutos)" Minimum="1" Maximum="10080" SpinButtonPlacementMode="Compact" />
                    <NumberBox x:Name="PollIntervalNumberBox" Header="Comprobar cada (minutos)" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Compact" />
                    <ComboBox x:Name="RepeatReminderComboBox" Header="Repetir recordatorios cada">
                        <ComboBoxItem Content="Nunca" Tag="0" />
                        <ComboBoxItem Content="15 minutos" Tag="15" />
                        <ComboBoxItem Content="30 minutos" Tag="30" />
                        <ComboBoxItem Content="60 minutos" Tag="60" />
                    </ComboBox>
                    <TextBlock Text="El primer aviso se envía al detectar la tarjeta. Las repeticiones se envían en la primera comprobación tras cumplirse el intervalo, también al pulsar Comprobar ahora." Opacity="0.65" TextWrapping="Wrap" />
                    <CheckBox x:Name="IncludeOverdueCheckBox" Content="Incluir tarjetas vencidas pendientes" />
                    <TextBlock Text="Las vencidas se recuerdan cada 2 horas desde su último aviso. Nunca desactiva también estas repeticiones. Si hay varias tarjetas para avisar, se muestra un resumen." Opacity="0.65" TextWrapping="Wrap" />
                    <CheckBox x:Name="SoundCheckBox" Content="Reproducir sonido en las notificaciones" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Apariencia" Style="{StaticResource SectionTitleStyle}" />
                    <ComboBox x:Name="ThemeComboBox" Header="Tema" SelectionChanged="Theme_SelectionChanged">
                        <ComboBoxItem Content="Usar configuración de Windows" Tag="Default" />
                        <ComboBoxItem Content="Claro" Tag="Light" />
                        <ComboBoxItem Content="Oscuro" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,24">
                <Button Content="Guardar cambios" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="Probar conexión" Click="TestConnection_Click" />
                <Button Content="Probar notificación" Click="TestNotification_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
