<Page
    x:Class="TrelloNotifier.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource AppPageBackgroundBrush}">
        <NavigationView
            x:Name="Navigation"
            PaneTitle="Trello Notifier"
            OpenPaneLength="232"
            CompactPaneLength="56"
            ExpandedModeThresholdWidth="1100"
            CompactModeThresholdWidth="640"
            AlwaysShowHeader="False"
            Background="{ThemeResource AppPageBackgroundBrush}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            Loaded="Navigation_Loaded"
            ItemInvoked="Navigation_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Mis tarjetas" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Padding="24" />
        </NavigationView>
        <InfoBar
            x:Name="StatusInfoBar"
            Margin="24"
            CornerRadius="8"
            VerticalAlignment="Bottom"
            IsClosable="True" />
    </Grid>
</Page>
