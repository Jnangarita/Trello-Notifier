<Page
    x:Class="TrelloNotifier.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource AppPageBackgroundBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactNavigation">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="ExpandedNavigation">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Navigation.IsPaneToggleButtonVisible" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <NavigationView
            x:Name="Navigation"
            OpenPaneLength="252"
            CompactPaneLength="56"
            ExpandedModeThresholdWidth="1100"
            CompactModeThresholdWidth="640"
            AlwaysShowHeader="False"
            Background="{ThemeResource AppNavigationBackgroundBrush}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            Loaded="Navigation_Loaded"
            ItemInvoked="Navigation_ItemInvoked">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#DDEAFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#182F4D" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,12,0,24">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource AppBrandBrush}">
                        <FontIcon Glyph="&#xEA8F;" FontSize="21" Foreground="{ThemeResource AppBrandTextBrush}" />
                    </Border>
                    <TextBlock Text="Trello Notifier" FontSize="17" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Mis tarjetas" Tag="Dashboard" FontWeight="SemiBold">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Historial" Tag="History" FontWeight="SemiBold">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Padding="24" Background="{ThemeResource AppPageBackgroundBrush}" />
        </NavigationView>
        <InfoBar
            x:Name="StatusInfoBar"
            Margin="24"
            CornerRadius="8"
            VerticalAlignment="Bottom"
            IsClosable="True" />
    </Grid>
</Page>
